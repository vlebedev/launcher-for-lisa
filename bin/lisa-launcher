#!/usr/bin/env bash
#
# lisa-launcher — school-site launcher for Lisa on Omarchy / Hyprland.
#
# sites.json in this repo is the single source of truth. `install` regenerates
# every piece of per-user config from it; every subcommand is idempotent.
#
# See docs/design.md for the contract this implements.

set -euo pipefail

# Absolute path to this script even when invoked through ~/.local/bin/lisa-launcher,
# because the generated Hyprland config and systemd units must not rely on PATH.
SELF=$(readlink -f "${BASH_SOURCE[0]}")
BIN_DIR=$(dirname "$SELF")
REPO=$(dirname "$BIN_DIR")
SITES="$REPO/sites.json"

# Omarchy itself reads these from $HOME/.config unconditionally
# (Menu.qml userMenuPath, default/hypr/bootstrap.lua package.path), so we do too.
CONFIG_HOME="$HOME/.config"
MENU_FILE="$CONFIG_HOME/omarchy/extensions/omarchy-menu.jsonc"
HYPR_DIR="$CONFIG_HOME/hypr"
HYPR_MODULE="$HYPR_DIR/lisa-launcher.lua"
HYPRLAND_LUA="$HYPR_DIR/hyprland.lua"
UNITS_DIR="$CONFIG_HOME/systemd/user"
LOGINS_FILE="$CONFIG_HOME/lisa-launcher/logins"
LOCAL_BIN="$HOME/.local/bin"

# The menu route and the Hyprland module name. `omarchy-menu toggle lisa`
# resolves this: MenuModel.resolveRoute() lowercases the route, turns "_" into
# "-", and prefers an exact item id over any alias.
MENU_ID="lisa"
MENU_LABEL="Lisa"
# Nerd Font graduation cap (U+F19D), verified present in JetBrainsMono Nerd Font.
# Written as raw UTF-8 bytes: $'\uF19D' would expand to the literal six characters
# \uF19D under a non-UTF-8 locale (C/POSIX), e.g. when install runs under `env -i`.
MENU_GLYPH=$(printf '\xef\x86\x9d')

REQUIRE_LINE='require("hypr.lisa-launcher")'
SKEL_HYPRLAND_LUA="/etc/skel/.config/hypr/hyprland.lua"

die() {
  printf 'lisa-launcher: %s\n' "$1" >&2
  exit "${2:-1}"
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# --- sites.json ---------------------------------------------------------------

# Accept either a bare array (what this repo ships) or {"sites": [...]}.
sites_json() {
  [[ -r $SITES ]] || die "cannot read $SITES"
  jq -e 'if type == "array" then . else .sites end
         | if type == "array" then . else error("sites.json: expected an array") end' "$SITES" \
    || die "sites.json is not valid JSON or has no site array"
}

site_by_id() {
  sites_json | jq -e --arg id "$1" 'map(select(.id == $id)) | first // empty'
}

# --- URL / window-class helpers -----------------------------------------------

# Escape regex metacharacters so a host's dots cannot match arbitrary characters.
regex_escape() {
  printf '%s' "$1" | sed 's/[][\.^$*+?(){}|]/\\&/g'
}

# The middle of a Chromium --app window class: "<host>__<path>", where the path
# has its leading "/" dropped and every remaining "/" turned into "_".
# Verified against live windows on the reference machine:
#   https://web.whatsapp.com          -> web.whatsapp.com__
#   https://mail.google.com/mail/u/0/ -> mail.google.com__mail_u_0_
#   https://calendar.google.com/calendar/u/0/r -> calendar.google.com__calendar_u_0_r
url_app_slug() {
  local rest=${1#*://}
  rest=${rest%%\?*}
  rest=${rest%%#*}

  local host=${rest%%/*}
  host=${host##*@}

  local path=""
  [[ $rest == */* ]] && path=${rest#*/}

  printf '%s__%s' "${host,,}" "${path//\//_}"
}

# Chromium names an --app window `chrome-<slug>-Default`.
window_class() {
  printf 'chrome-%s-Default' "$(url_app_slug "$1")"
}

# The same class as an anchored regex for o.window's `class` match, which is a
# regex (default/hypr/apps/browser.lua matches "^.+-youtube\\.com__.*$").
window_class_regex() {
  printf '^chrome-%s-Default$' "$(regex_escape "$(url_app_slug "$1")")"
}

# Pattern handed to omarchy-launch-or-focus, which matches with
# test("\\b" + pattern + "\\b"; "i") against .class and .title. Keeping the
# "-Default" suffix makes it unique to this site's app window: a normal Chromium
# window, or a tab whose title merely mentions the host, cannot match.
focus_pattern() {
  printf '%s-Default' "$(regex_escape "$(url_app_slug "$1")")"
}

# --- generators ---------------------------------------------------------------

# Only whole-line "//" comments survive MenuModel.stripJsonc(), and trailing
# commas before } or ] are stripped, so both are safe to emit here.
write_menu_file() {
  local tmp
  mkdir -p "$(dirname "$MENU_FILE")"
  tmp=$(mktemp "$MENU_FILE.XXXXXX")

  {
    printf '{\n'
    printf '  // Generated by lisa-launcher from sites.json. Do not edit by hand:\n'
    printf '  // edit sites.json in the launcher-for-lisa repo and run\n'
    printf '  //   %s install\n' "$SELF"
    printf '\n'
    printf '  "%s": {"icon":"%s","label":"%s","aliases":["%s"]},\n' \
      "$MENU_ID" "$MENU_GLYPH" "$MENU_LABEL" "$MENU_ID"
    sites_json | jq -r --arg abs "$SELF" --arg menu "$MENU_ID" '
      .[] | "  " + ({ ($menu + "." + .id): {
                        icon: .glyph,
                        label: .label,
                        action: ($abs + " open " + .id)
                      } } | tojson | .[1:-1]) + ","
    '
    printf '}\n'
  } >"$tmp"

  chmod 644 "$tmp"
  mv -f "$tmp" "$MENU_FILE"
}

lua_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# o.window(match, rules) is defined in /usr/share/omarchy/default/hypr/helpers.lua;
# a table match copies its keys into rules.match and `class` is a regex
# (see default/hypr/apps/browser.lua, which anchors and escapes the same way).
write_hypr_module() {
  local tmp
  mkdir -p "$HYPR_DIR"
  tmp=$(mktemp "$HYPR_MODULE.XXXXXX")

  {
    printf -- '-- Generated by lisa-launcher from sites.json. Do not edit by hand:\n'
    printf -- '-- edit sites.json in the launcher-for-lisa repo and run\n'
    printf -- '--   %s install\n' "$SELF"
    printf '\n'
    printf -- '-- Both keys open the school menu. This Apple keyboard sends\n'
    printf -- '-- XF86MonBrightnessDown for a bare F1 and F1 for Fn+F1, so bind both.\n'
    printf -- '-- Overriding Omarchy'"'"'s brightness-down bind is intentional: Hyprland runs\n'
    printf -- '-- every bind registered for a key, so the default must be removed first\n'
    printf -- '-- (default/hypr/bindings/media.lua binds it to omarchy-brightness-display 5%%-).\n'
    printf -- '-- hl.unbind is Omarchy'"'"'s documented override mechanism, see\n'
    printf -- '-- /etc/skel/.config/hypr/bindings.lua. This module is required after\n'
    printf -- '-- require("default.hypr.omarchy"), so the default bind exists by now.\n'
    printf 'hl.unbind("XF86MonBrightnessDown")\n'
    printf 'o.bind("F1", "Lisa launcher", %s)\n' "$(lua_string "$SELF menu")"
    printf 'o.bind("XF86MonBrightnessDown", "Lisa launcher", %s)\n' "$(lua_string "$SELF menu")"
    printf '\n'
    printf -- '-- Each site gets a fixed workspace; workspace 1 stays empty as "home".\n'

    local id pattern workspace lua_class
    while IFS=$'\t' read -r id pattern workspace; do
      [[ -n $id ]] || continue
      # Double the backslashes for the Lua string literal, as browser.lua does.
      lua_class=${pattern//\\/\\\\}
      printf 'o.window({ class = "%s" }, { workspace = "%s" }) -- %s\n' \
        "$lua_class" "$workspace" "$id"
    done < <(
      sites_json | jq -r '.[] | [.id, .url, (.workspace | tostring)] | @tsv' |
        while IFS=$'\t' read -r sid surl sws; do
          printf '%s\t%s\t%s\n' "$sid" "$(window_class_regex "$surl")" "$sws"
        done
    )
  } >"$tmp"

  chmod 644 "$tmp"
  mv -f "$tmp" "$HYPR_MODULE"
}

# $HOME/.config is on package.path (default/hypr/bootstrap.lua), so
# require("hypr.lisa-launcher") loads $HOME/.config/hypr/lisa-launcher.lua.
ensure_require_line() {
  if [[ ! -f $HYPRLAND_LUA ]]; then
    mkdir -p "$HYPR_DIR"
    if [[ -r $SKEL_HYPRLAND_LUA ]]; then
      cp "$SKEL_HYPRLAND_LUA" "$HYPRLAND_LUA"
      echo "  created $HYPRLAND_LUA from $SKEL_HYPRLAND_LUA"
    else
      cat >"$HYPRLAND_LUA" <<'LUA'
-- Created by lisa-launcher (no /etc/skel template was available).
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")
require("default.hypr.omarchy")
require("default.hypr.toggles")
LUA
      echo "  created a minimal $HYPRLAND_LUA"
    fi
  fi

  # An uncommented require only; a "-- require(...)" line does not count.
  if grep -qE '^[[:space:]]*require\("hypr\.lisa-launcher"\)' "$HYPRLAND_LUA"; then
    echo "  $HYPRLAND_LUA already requires hypr.lisa-launcher"
    return 0
  fi

  printf '\n-- Lisa launcher (added by lisa-launcher install).\n%s\n' "$REQUIRE_LINE" >>"$HYPRLAND_LUA"
  echo "  appended $REQUIRE_LINE to $HYPRLAND_LUA"
}

# True only when we are configuring the home directory of the user we are running
# as. `install` may run as root or under sudo -u with an overridden HOME, and in
# those cases the running systemd user manager and Hyprland instance belong to
# somebody else — leave them alone.
owns_home() {
  local passwd_home
  passwd_home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6 || true)
  [[ -n $passwd_home && $HOME == "$passwd_home" ]]
}

install_units() {
  local unit
  mkdir -p "$UNITS_DIR/timers.target.wants"
  for unit in lisa-launcher-update.service lisa-launcher-update.timer; do
    [[ -r $REPO/systemd/$unit ]] || die "missing unit file: $REPO/systemd/$unit"
    install -m 644 "$REPO/systemd/$unit" "$UNITS_DIR/$unit"
  done

  # Enable the timer without a running user manager: this is exactly the symlink
  # `systemctl --user enable` would create, so a later enable/disable agrees.
  ln -sfn "../lisa-launcher-update.timer" "$UNITS_DIR/timers.target.wants/lisa-launcher-update.timer"
  echo "  installed units into $UNITS_DIR and linked timers.target.wants"

  if owns_home && [[ -n ${XDG_RUNTIME_DIR:-} && -d ${XDG_RUNTIME_DIR:-/nonexistent} ]] &&
    systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    if systemctl --user enable --now lisa-launcher-update.timer >/dev/null 2>&1; then
      echo "  enabled lisa-launcher-update.timer in the running user manager"
    fi
  else
    echo "  no usable systemd user manager; the symlink above enables it at next login"
  fi
}

link_cli() {
  mkdir -p "$LOCAL_BIN"
  ln -sfn "$SELF" "$LOCAL_BIN/lisa-launcher"
  echo "  linked $LOCAL_BIN/lisa-launcher -> $SELF"
}

reload_session() {
  if owns_home && command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
    command -v omarchy-menu >/dev/null 2>&1 && omarchy-menu refresh >/dev/null 2>&1 || true
    echo "  reloaded the running Hyprland session and the Omarchy menu"
  else
    echo "  no Hyprland session for this user; changes apply at next login"
  fi
}

# --- subcommands ---------------------------------------------------------------

cmd_install() {
  need jq
  sites_json >/dev/null

  echo "lisa-launcher install (repo: $REPO)"
  write_menu_file
  echo "  wrote $MENU_FILE"
  write_hypr_module
  echo "  wrote $HYPR_MODULE"
  ensure_require_line
  install_units
  link_cli
  reload_session
}

cmd_menu() {
  need omarchy-menu
  exec omarchy-menu toggle "$MENU_ID"
}

cmd_open() {
  need jq
  local dry=0
  if [[ ${1:-} == --dry-run ]]; then
    dry=1
    shift
  fi

  local id=${1:-}
  [[ -n $id ]] || die "usage: lisa-launcher open [--dry-run] <id>"

  local site url pattern
  site=$(site_by_id "$id" 2>/dev/null) ||
    die "unknown site '$id'. Known ids: $(sites_json | jq -r 'map(.id) | join(", ")')"
  url=$(jq -r '.url' <<<"$site")
  pattern=$(focus_pattern "$url")

  if ((dry)); then
    printf 'id\t%s\n' "$id"
    printf 'url\t%s\n' "$url"
    printf 'class\t%s\n' "$(window_class "$url")"
    printf 'pattern\t%s\n' "$pattern"
    printf 'workspace\t%s\n' "$(jq -r '.workspace' <<<"$site")"
    printf 'command\tomarchy-launch-or-focus-webapp %q %s\n' "$pattern" "$(printf '%q' "$url")"
    return 0
  fi

  # omarchy-launch-or-focus-webapp folds its arguments into an unquoted string that
  # omarchy-launch-or-focus then runs through `eval exec setsid $LAUNCH_COMMAND`, so
  # pre-quote the URL: "&", ";" and spaces would otherwise split or background it.
  need omarchy-launch-or-focus-webapp
  exec omarchy-launch-or-focus-webapp "$pattern" "$(printf '%q' "$url")"
}

# Reads $HOME/.config/lisa-launcher/logins: one "<id><TAB><url>" per line,
# "#" comments and blank lines allowed. The file is secret; never print a URL.
logins_ids() {
  awk -F'\t' '
    { sub(/\r$/, "") }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
      # A line with no TAB or an empty URL is malformed: never offer it as an id,
      # because logins_url would reject it right back.
      if ($1 != "" && $2 != "") print $1
    }
  ' "$LOGINS_FILE"
}

logins_url() {
  awk -F'\t' -v want="$1" '
    { sub(/\r$/, "") }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
      if ($1 == want && $2 != "") { print $2; found = 1; exit }
    }
    END { if (!found) exit 1 }
  ' "$LOGINS_FILE"
}

cmd_login() {
  local dry=0
  if [[ ${1:-} == --dry-run ]]; then
    dry=1
    shift
  fi

  [[ -r $LOGINS_FILE ]] ||
    die "no login file at $LOGINS_FILE. The owner installs it (mode 600); it is never committed."

  local id=${1:-}
  if [[ -z $id ]]; then
    local ids
    ids=$(logins_ids)
    [[ -n $ids ]] || die "$LOGINS_FILE has no entries"
    echo "Login links available (run: lisa-launcher login <id>):"
    printf '%s\n' "$ids" | sed 's/^/  /'
    return 0
  fi

  local url
  url=$(logins_url "$id") ||
    die "no login link for '$id' in $LOGINS_FILE. Available: $(logins_ids | paste -sd, - | sed 's/,/, /g')"

  if ((dry)); then
    echo "would open the login link for '$id' with omarchy-launch-webapp"
    return 0
  fi

  need omarchy-launch-webapp
  exec omarchy-launch-webapp "$url"
}

cmd_update() {
  local force=0
  [[ ${1:-} == --force ]] && force=1

  need git
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "lisa-launcher: $REPO is not a git checkout; nothing to update" >&2
    return 0
  }

  local before after
  before=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || printf '')
  # Never prompt and never spam: a pull that cannot reach the network is a no-op.
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' \
    git -C "$REPO" pull --ff-only --quiet >/dev/null 2>&1 || true
  after=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || printf '')

  if ((force)) || [[ $before != "$after" ]]; then
    cmd_install
  fi
}

cmd_list() {
  need jq
  printf '%-10s %-10s %-9s %s\n' ID LABEL WORKSPACE URL
  sites_json | jq -r '.[] | [.id, .label, (.workspace | tostring), .url] | @tsv' |
    while IFS=$'\t' read -r id label ws url; do
      printf '%-10s %-10s %-9s %s\n' "$id" "$label" "$ws" "$url"
    done
}

usage() {
  cat <<USAGE
lisa-launcher — school-site launcher for Lisa (Omarchy / Hyprland)

Usage: lisa-launcher <command> [args]

  install              Regenerate every piece of per-user config from sites.json:
                       the Omarchy menu extension, the Hyprland module (F1 and
                       brightness-down binds plus one workspace rule per site),
                       the systemd user timer, and ~/.local/bin/lisa-launcher.
                       Idempotent; safe to run before the user has ever logged in.
  menu                 Toggle the "$MENU_LABEL" menu (omarchy-menu toggle $MENU_ID).
  open [--dry-run] <id>
                       Open a site as a Chromium app window on its workspace, or
                       focus it if it is already open. --dry-run only prints what
                       would run.
  login [--dry-run] [<id>]
                       Open the stored login link for <id> so its cookie lands in
                       the same Chromium profile. With no id, list the ids present
                       in $LOGINS_FILE (never the links).
  update [--force]     git pull --ff-only, then install if HEAD moved (or always,
                       with --force). Silent on network failure; never prompts.
  list                 Print the site table.
  help                 This text.

sites.json in the repo is the single source of truth: $SITES
USAGE
}

main() {
  local cmd=${1:-help}
  [[ $# -gt 0 ]] && shift || true

  case "$cmd" in
    install) cmd_install "$@" ;;
    menu) cmd_menu "$@" ;;
    open) cmd_open "$@" ;;
    login) cmd_login "$@" ;;
    update) cmd_update "$@" ;;
    list) cmd_list "$@" ;;
    help | -h | --help) usage ;;
    *)
      usage >&2
      die "unknown command '$cmd'" 2
      ;;
  esac
}

main "$@"
